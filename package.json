{
  "name": "@utexo/rgb-sdk",
  "version": "2.0.0-alpha.0",
  "description": "Optional UTEXOWallet facade over one RGB wallet engine (React Native or web), built on the @utexo/rgb-sdk-core contract",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./webrgb": {
      "types": "./lib/webrgb/index.d.ts",
      "default": "./lib/webrgb/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf lib",
    "build": "rm -rf lib && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint \"**/*.{js,mjs,cjs,ts,tsx}\"",
    "prettier": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx}\"",
    "test:unit": "npm run build && node --test tests/*.test.mjs",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run typecheck:examples",
    "typecheck:examples": "tsc -p examples/webrgb-extension/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/UTEXO-Protocol/rgb-sdk.git"
  },
  "keywords": [
    "rgb",
    "rgb-protocol",
    "bitcoin",
    "wallet",
    "react-native",
    "web",
    "sdk"
  ],
  "peerDependencies": {
    "@utexo/rgb-sdk-core": "^1.0.0-beta.10",
    "@utexo/webrgb": "^0.1.7"
  },
  "peerDependenciesMeta": {
    "@utexo/webrgb": {
      "optional": true
    }
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@scure/base": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/chrome": "0.0.268",
    "@types/node": "^22.17.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@utexo/rgb-sdk-core": "1.0.0-beta.10",
    "@utexo/rgb-sdk-web": "1.0.0-beta.13",
    "@utexo/webrgb": "0.1.7",
    "@utexo/webrgb-walletconnect": "0.1.7",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.0.0",
    "typescript": "^5.9.2"
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
